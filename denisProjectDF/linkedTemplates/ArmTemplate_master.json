{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "denisProjectDF"
		},
		"Adf2AzSql_LS_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Adf2AzSql_LS'"
		},
		"MySql2Adf_LS_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'MySql2Adf_LS'"
		},
		"Adf2AzSql_LS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dbdenis.database.windows.net"
		},
		"Adf2AzSql_LS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "denis_db"
		},
		"Adf2AzSql_LS_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "denis_admin"
		},
		"MySql2Adf_LS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"MySql2Adf_LS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "denis_db"
		},
		"MySql2Adf_LS_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "denisProjectDF_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Adf2AzSql_LS_password": {
						"value": "[parameters('Adf2AzSql_LS_password')]"
					},
					"MySql2Adf_LS_password": {
						"value": "[parameters('MySql2Adf_LS_password')]"
					},
					"Adf2AzSql_LS_properties_typeProperties_server": {
						"value": "[parameters('Adf2AzSql_LS_properties_typeProperties_server')]"
					},
					"Adf2AzSql_LS_properties_typeProperties_database": {
						"value": "[parameters('Adf2AzSql_LS_properties_typeProperties_database')]"
					},
					"Adf2AzSql_LS_properties_typeProperties_userName": {
						"value": "[parameters('Adf2AzSql_LS_properties_typeProperties_userName')]"
					},
					"MySql2Adf_LS_properties_typeProperties_server": {
						"value": "[parameters('MySql2Adf_LS_properties_typeProperties_server')]"
					},
					"MySql2Adf_LS_properties_typeProperties_database": {
						"value": "[parameters('MySql2Adf_LS_properties_typeProperties_database')]"
					},
					"MySql2Adf_LS_properties_typeProperties_username": {
						"value": "[parameters('MySql2Adf_LS_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}